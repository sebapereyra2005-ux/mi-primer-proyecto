# NEXUS — Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.

# --- Proveedor de IA ---
# Valores válidos: "mock" | "gemini" | "openai"
VITE_AI_PROVIDER=mock

# --- Google Gemini ---
# Necesario solo si VITE_AI_PROVIDER=gemini
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI ---
# Necesario solo si VITE_AI_PROVIDER=openai
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
